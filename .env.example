# Port for the API server (in production it also serves the built frontend)
PORT=3001

# Secret used to sign the session cookie. REQUIRED in production.
SESSION_SECRET=change-me

# Database. Defaults to a local SQLite file. For a persistent cloud DB use a
# free Turso (libSQL) database: DATABASE_URL=libsql://<db>.turso.io
DATABASE_URL=file:data/ajaia-docs.db
DATABASE_AUTH_TOKEN=
